# =============================================================================
# Voeq — Environment Variable Template
# Copy to `.env.local` (web, gitignored) and/or set in Vercel/Render dashboards.
# `validateEnv(target)` (packages/data/src/env.ts) checks these at boot.
# In DEV: missing vars -> warning + mock fallback. In PROD: missing -> boot aborts.
# =============================================================================

# -----------------------------------------------------------------------------
# WEB (Vercel) — NEXT_PUBLIC_* are exposed to the browser.
# -----------------------------------------------------------------------------
# Base URL of the Render API. Web calls this cross-origin (CORS allowlisted on API).
NEXT_PUBLIC_API_URL=https://voeq-api.onrender.com

# Cloudinary (public read-only config; the secret keys live on the API side).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=voeq_unsigned

# Cloudflare Turnstile site key (public; the secret lives on the API side).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEZcnQcg6AZ2SqFM

# -----------------------------------------------------------------------------
# API (Render) — server-only secrets. NEVER prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
# Neon Postgres connection string (Drizzle/postgres-js). Presence switches the
# data layer from in-memory mock to real Neon repos (factory in packages/data).
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/voeq?sslmode=require

# Session signing/encryption secret (generate: openssl rand -base64 48).
VOEQ_SESSION_SECRET=replace-with-a-long-random-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=voeq_unsigned

# Sightengine (image moderation)
SIGHTENGINE_USER=your_user
SIGHTENGINE_SECRET=your_secret

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@voeq.ng

# Google OAuth
AUTH_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Base URL of the web app (used in email links / magic-link reset). Vercel sets this.
NEXT_PUBLIC_SITE_URL=https://voeq.ng

# Cloudflare Turnstile (secret — server-side verification only)
TURNSTILE_SECRET_KEY=0x4AAAAAAEZcnc2rgtR11CX1759qgIIlYUw

# CORS allowlist (comma-separated origins the API accepts cross-origin from).
CORS_ALLOWLIST=https://voeq.ng,https://www.voeq.ng,https://voeq-web.vercel.app

# Super-admin bootstrap email (seeds the first super_admin identity).
SUPER_ADMIN_EMAIL=admin@voeq.ng

# -----------------------------------------------------------------------------
# Optional / dev-only
# -----------------------------------------------------------------------------
# Disable rate limiting in local dev (rate limiting is enforced in prod).
VOEQ_RATE_LIMIT_DISABLED=true
# Dev super-admin email for the /api/dev/bootstrap route.
VOEQ_SUPER_ADMIN_EMAIL=admin@voeq.africa
